<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared between NotOnlyFans.Service and the window app:
    the messages sent over the named pipe (JSON, one message per line).
    No dependency on LibreHardwareMonitor, so the window app stays light.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NotOnlyFans.Contracts</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

</Project>
