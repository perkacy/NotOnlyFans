<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="NotOnlyFans.Controls.HistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The last 5 minutes of one reading: line, three scale lines with values on the right, value under the pointer. -->
    <Grid ColumnSpacing="10" RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="44" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Grid>

        <Canvas x:Name="Plot" Background="Transparent" PointerMoved="Plot_PointerMoved" PointerExited="Plot_PointerExited" SizeChanged="Plot_SizeChanged">
            <Polyline x:Name="Line" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
            <Line x:Name="HoverLine" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1" Visibility="Collapsed" />
            <Ellipse x:Name="HoverDot" Width="7" Height="7" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
            <Border
                x:Name="HoverTip"
                Visibility="Collapsed"
                Padding="8,3,8,4"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
                <TextBlock x:Name="HoverText" Style="{StaticResource CaptionTextBlockStyle}" />
            </Border>
        </Canvas>

        <!-- Scale: top, middle and bottom value, each centered on its line. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TopLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="0,-8,0,0" />
            <TextBlock x:Name="MidLabel" Grid.Row="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="0,-8,0,0" />
            <TextBlock x:Name="BottomLabel" Grid.Row="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,-8" />
        </Grid>

        <Grid x:Name="TimeAxis" Grid.Row="1" Margin="0,6,0,0">
            <TextBlock Text="5 min ago" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Now" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>
