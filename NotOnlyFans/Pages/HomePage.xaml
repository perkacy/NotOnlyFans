<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NotOnlyFans.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NotOnlyFans.ViewModels"
    xmlns:controls="using:NotOnlyFans.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!-- Tiles are buttons (click = details) that look like cards: card fill, slightly lighter on hover. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="ButtonBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CardBackgroundFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CardBackgroundFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ButtonBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CardBackgroundFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CardBackgroundFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="CardStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="CardStrokeColorDefaultBrush" />
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextFillColorPrimaryBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="TileButton" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="IconBox" TargetType="Border">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="IconPath" TargetType="Path">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.6" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <Style x:Key="Sub" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="BigValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="40" />
                <Setter Property="LineHeight" Value="44" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            </Style>

            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>

            <DataTemplate x:Key="ChipTemplate" x:DataType="vm:ValueChipViewModel">
                <Border Style="{StaticResource Chip}">
                    <StackPanel>
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="28,12,40,40" Spacing="12" MaxWidth="1200" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="All temperatures and fans at a glance" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar
                x:Name="ServiceInfo"
                Severity="Warning"
                IsClosable="False"
                IsOpen="False"
                Title="Sensor service isn't running"
                Message="Readings come from the NotOnlyFans background service. Start it in Services, or install it with tools\Install-Service.ps1. Readings appear here on their own." />

            <Grid x:Name="Tiles" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CPU -->
                <Button x:Name="CpuTile" Style="{StaticResource TileButton}" Click="ToSensors_Click" AutomationProperties.Name="CPU details">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBox}">
                                <Viewbox Width="20" Height="20">
                                    <Path Style="{StaticResource IconPath}" Data="M7.5,6 H16.5 A1.5,1.5 0 0 1 18,7.5 V16.5 A1.5,1.5 0 0 1 16.5,18 H7.5 A1.5,1.5 0 0 1 6,16.5 V7.5 A1.5,1.5 0 0 1 7.5,6 Z M9.5,9.5 H14.5 V14.5 H9.5 Z M9,2.5 V6 M15,2.5 V6 M9,18 V21.5 M15,18 V21.5 M2.5,9 H6 M2.5,15 H6 M18,9 H21.5 M18,15 H21.5" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="CPU" FontWeight="SemiBold" />
                                <TextBlock x:Name="CpuName" Style="{StaticResource Sub}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BigValue}" VerticalAlignment="Bottom">
                                <Run x:Name="CpuTemp" Text="—" /><Run Text=" °C" FontSize="20" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <TextBlock Text="Load" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="CpuLoad" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock Text="Clock" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="CpuClock" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <TextBlock Text="Power" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="CpuPower" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="CpuSparkHost" Height="40" SizeChanged="SparkHost_SizeChanged">
                            <Polyline x:Name="CpuSpark" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                        </Grid>
                        <TextBlock x:Name="CpuSparkCaption" Text="Last 5 minutes" Style="{StaticResource Caption}" />
                        <!-- CPU cooler fan(s): the motherboard headers named "CPU..." (renamed ones keep their place). -->
                        <ItemsRepeater x:Name="CpuFans" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="160" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Button>

                <!-- GPU -->
                <Button x:Name="GpuTile" Grid.Column="1" Style="{StaticResource TileButton}" Click="ToSensors_Click" AutomationProperties.Name="GPU details">
                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBox}">
                                <Viewbox Width="20" Height="20">
                                    <Path Style="{StaticResource IconPath}" Data="M4,6.5 H20 A1.5,1.5 0 0 1 21.5,8 V16 A1.5,1.5 0 0 1 20,17.5 H4 A1.5,1.5 0 0 1 2.5,16 V8 A1.5,1.5 0 0 1 4,6.5 Z M6,12 A3,3 0 1 0 12,12 A3,3 0 1 0 6,12 Z M14.5,12 A2,2 0 1 0 18.5,12 A2,2 0 1 0 14.5,12 Z M5,17.5 V19.5" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="GPU" FontWeight="SemiBold" />
                                <TextBlock x:Name="GpuName" Style="{StaticResource Sub}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BigValue}" VerticalAlignment="Bottom">
                                <Run x:Name="GpuTemp" Text="—" /><Run Text=" °C" FontSize="20" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                <TextBlock Text="Hotspot" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="GpuHot" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock Text="Load" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="GpuLoad" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <TextBlock Text="Power" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="GpuPower" Text="—" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="GpuSparkHost" Height="40" SizeChanged="SparkHost_SizeChanged">
                            <Polyline x:Name="GpuSpark" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                        </Grid>
                        <ItemsRepeater x:Name="GpuFans" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="160" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Button>

                <!-- Motherboard -->
                <Button x:Name="BoardTile" Grid.Row="1" Style="{StaticResource TileButton}" Click="ToSensors_Click" AutomationProperties.Name="Motherboard details">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBox}">
                                <Viewbox Width="20" Height="20">
                                    <Path Style="{StaticResource IconPath}" Data="M5,3 H19 A2,2 0 0 1 21,5 V19 A2,2 0 0 1 19,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 Z M7,7 H12 V12 H7 Z M15,7 H17.5 M15,10 H17.5 M7,15.5 H17 M7,18 H13" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Motherboard" FontWeight="SemiBold" />
                                <TextBlock x:Name="BoardName" Style="{StaticResource Sub}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ItemsRepeater x:Name="BoardTemps" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="140" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Button>

                <!-- Drives -->
                <Button x:Name="DrivesTile" Grid.Row="1" Grid.Column="1" Style="{StaticResource TileButton}" Click="ToSensors_Click" AutomationProperties.Name="Drives details">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconBox}">
                                <Viewbox Width="20" Height="20">
                                    <Path Style="{StaticResource IconPath}" Data="M4,8 H20 A1.5,1.5 0 0 1 21.5,9.5 V14.5 A1.5,1.5 0 0 1 20,16 H4 A1.5,1.5 0 0 1 2.5,14.5 V9.5 A1.5,1.5 0 0 1 4,8 Z M6,12 H12 M16.7,12 A0.8,0.8 0 1 0 18.3,12 A0.8,0.8 0 1 0 16.7,12 Z" />
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Drives" FontWeight="SemiBold" />
                                <TextBlock x:Name="DrivesCount" Style="{StaticResource Sub}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ItemsRepeater x:Name="Drives">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:DriveViewModel">
                                    <Border Style="{StaticResource Chip}" Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Temperature, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Fans -->
            <Border x:Name="FansCard" Style="{StaticResource Card}" Padding="20,16,20,8">
                <StackPanel>
                    <Grid ColumnSpacing="12" Padding="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBox}">
                            <Viewbox Width="20" Height="20">
                                <Path Style="{StaticResource IconPath}" Data="M10.4,12 A1.6,1.6 0 1 0 13.6,12 A1.6,1.6 0 1 0 10.4,12 Z M12,10.4 C11.6,6 12.6,3 15.6,3.4 C18.2,3.8 17.4,7.8 12,10.4 M13.4,12.8 C17.2,15 19.2,17.6 17.3,19.8 C15.6,21.8 12.7,18.8 13.4,12.8 M10.6,12.8 C6.6,14.8 3.6,15.2 3,12.4 C2.5,9.8 6.5,9 10.6,12.8" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Fans" FontWeight="SemiBold" />
                            <TextBlock x:Name="FansSummary" Style="{StaticResource Sub}" />
                        </StackPanel>
                        <controls:LinkButton Grid.Column="2" Content="Open Cooling" Click="ToCooling_Click" />
                    </Grid>
                    <!--
                        Fans in the user's order. Press and drag a row to move it: the row follows the pointer
                        with a hand cursor, the others step aside at once (short, interruptible movement).
                        Right-click for Rename / Move up / Move down (also from the keyboard: Shift+F10).
                    -->
                    <ItemsRepeater x:Name="Fans" AutomationProperties.Name="Fans">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FanRowViewModel">
                                <controls:DragRow
                                    Tag="{x:Bind}"
                                    ColumnSpacing="20"
                                    Padding="8,12"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    PointerPressed="FanRow_PointerPressed"
                                    PointerMoved="FanRow_PointerMoved"
                                    PointerReleased="FanRow_PointerReleased"
                                    PointerCaptureLost="FanRow_PointerCaptureLost"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" controls:Responsive.Hide="3:600 1:440">
                                    <controls:DragRow.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Rename…" Tag="{x:Bind}" Click="RenameFan_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Move up" Tag="{x:Bind}" Click="MoveFanUp_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Move down" Tag="{x:Bind}" Click="MoveFanDown_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator Visibility="{x:Bind IsRenamed, Mode=OneWay}" />
                                            <MenuFlyoutItem Text="Use original name" Tag="{x:Bind}" Click="ResetFanName_Click" Visibility="{x:Bind IsRenamed, Mode=OneWay}" />
                                        </MenuFlyout>
                                    </controls:DragRow.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="0,3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Mode, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Rpm, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Grid Grid.Column="3" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{ThemeResource ControlStrongFillColorDisabledBrush}">
                                        <Border Width="{x:Bind BarWidth, Mode=OneWay}" HorizontalAlignment="Left" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Grid>
                                    <TextBlock Grid.Column="4" Text="{x:Bind Percent, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </controls:DragRow>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <TextBlock Text="Click a fan to set how it runs. Drag to change the order, right-click to rename." Style="{StaticResource Caption}" Margin="8,8,0,4" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
