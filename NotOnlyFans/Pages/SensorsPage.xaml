<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NotOnlyFans.Pages.SensorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:NotOnlyFans.ViewModels"
    xmlns:controls="using:NotOnlyFans.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!-- Buttons on this page (group headers, pins) are "subtle": no fill until hovered, like in Settings. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="ButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ValueText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!--
                One sensor row: used for the essential rows and for the "Show all" rows. Right-click: rename / hide.
                A click opens the sensor's last 5 minutes under it (the chart is only made when opened).
            -->
            <DataTemplate x:Key="SensorRowTemplate" x:DataType="vm:SensorRowViewModel">
                <Grid
                    Tag="{x:Bind}"
                    ContextRequested="Row_ContextRequested"
                    Tapped="Row_Tapped"
                    PointerEntered="Row_PointerEntered"
                    PointerExited="Row_PointerExited"
                    Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                    Background="Transparent"
                    ColumnSpacing="8" Padding="20,2"
                    controls:Responsive.Hide="2:560 3:460"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Rename…" Tag="{x:Bind}" Click="Rename_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Hide" Tag="{x:Bind}" Click="ToggleHidden_Click" Visibility="{x:Bind IsShown, Mode=OneWay}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Show" Tag="{x:Bind}" Click="ToggleHidden_Click" Visibility="{x:Bind IsHidden, Mode=OneWay}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B3;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator Visibility="{x:Bind IsRenamed, Mode=OneWay}" />
                            <MenuFlyoutItem Text="Use original name" Tag="{x:Bind}" Click="ResetName_Click" Visibility="{x:Bind IsRenamed, Mode=OneWay}" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Now, Mode=OneWay}" Style="{StaticResource ValueText}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Min, Mode=OneWay}" Style="{StaticResource ValueText}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Max, Mode=OneWay}" Style="{StaticResource ValueText}" />
                    <Button
                        Grid.Column="4"
                        Click="{x:Bind TogglePin}"
                        Width="32" Height="32" Padding="0"
                        HorizontalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind PinToolTip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind PinToolTip, Mode=OneWay}">
                        <Grid>
                            <FontIcon Glyph="&#xE718;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind IsUnpinned, Mode=OneWay}" />
                            <FontIcon Glyph="&#xE841;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind IsPinned, Mode=OneWay}" />
                        </Grid>
                    </Button>
                    <controls:HistoryChart
                        x:Name="Chart" x:Load="{x:Bind IsChartOpen, Mode=OneWay}"
                        Grid.Row="1" Grid.ColumnSpan="5"
                        Height="96" Margin="0,8,8,12"
                        Kind="{x:Bind Kind}"
                        SensorIndex="{x:Bind SensorIndex}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Padding="28,12,40,40" Spacing="12" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="16" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Sensors" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Every sensor in the PC. Pin the ones you want to see in the sidebar." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Width="240"
                    VerticalAlignment="Bottom"
                    PlaceholderText="Search sensors"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged"
                    AutomationProperties.Name="Search sensors" />
            </Grid>

            <InfoBar
                x:Name="ServiceInfo"
                Severity="Warning"
                IsClosable="False"
                IsOpen="False"
                Title="Sensor service isn't running"
                Message="Readings come from the NotOnlyFans background service. Start it in Services, or install it with tools\Install-Service.ps1. Readings appear here on their own." />

            <!--
                A plain ItemsControl, every card made at once (about ten): opening a card from Home or a pin needs
                the card and its rows to exist. ItemsRepeater.GetOrCreateElement for that crashed WinUI after a while
                ("Element is already the child of another element").
            -->
            <ItemsControl x:Name="GroupsList" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SensorGroupViewModel">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <Button
                                    Click="GroupHeader_Click"
                                    Tag="{x:Bind}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="20,12"
                                    CornerRadius="7"
                                    AutomationProperties.Name="{x:Bind Title}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind CountText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Button>

                                <StackPanel Visibility="{x:Bind IsOpen, Mode=OneWay}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <Grid ColumnSpacing="8" Padding="20,8" controls:Responsive.Hide="2:560 3:460">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sensor" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="Now" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Min" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="Max" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="Pin" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    </Grid>

                                    <!-- Essential rows: temperatures, fans, usage. -->
                                    <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource SensorRowTemplate}" IsTabStop="False" />

                                    <!-- Everything else, only after "Show all" (not created until then). -->
                                    <ItemsControl ItemsSource="{x:Bind MoreRows}" ItemTemplate="{StaticResource SensorRowTemplate}" IsTabStop="False" Visibility="{x:Bind IsShowingAll, Mode=OneWay}" />

                                    <Border Visibility="{x:Bind HasMore}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                                        <controls:LinkButton
                                            Content="{x:Bind ShowAllText, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            Click="ShowAll_Click" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="NoMatches" Text="No sensors match your search." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

            <!-- Footer from the mockup: how to rename/hide, and the hidden sensors. -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                <TextBlock Text="Click a sensor to see its last 5 minutes, right-click to rename or hide it." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="HiddenCount" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                <controls:LinkButton x:Name="ShowHiddenLink" FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center" Click="ShowHidden_Click" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
