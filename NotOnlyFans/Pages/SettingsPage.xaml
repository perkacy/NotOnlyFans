<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NotOnlyFans.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:NotOnlyFans.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,12" />
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="28,12,40,40" Spacing="4" MaxWidth="1200" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="App behavior and safety" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />

            <InfoBar x:Name="ServiceInfo" Severity="Warning" IsClosable="False" IsOpen="False"
                     Title="Sensor service isn't running"
                     Message="The safety rule lives in the NotOnlyFans background service. Start it in Services, or install it with tools\Install-Service.ps1." />
            <InfoBar x:Name="SafetyActiveInfo" Severity="Error" IsClosable="False" IsOpen="False" Title="Safety: fans at 100%" />
            <InfoBar x:Name="SafetyError" Severity="Warning" IsClosable="True" IsOpen="False" Title="Couldn't change the safety temperature" />

            <!-- ===== Safety ===== -->
            <TextBlock Text="Safety" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Emergency temperature" />
                        <TextBlock x:Name="SafetyHint" Style="{StaticResource Sub}" />
                    </StackPanel>
                    <controls:LinkButton x:Name="SafetyReset" Grid.Column="1" Content="Restore 90 °C" VerticalAlignment="Center"
                                     Click="SafetyReset_Click" Visibility="Collapsed" />
                    <controls:Stepper x:Name="SafetyBox" Grid.Column="2" SmallChange="1" LargeChange="5"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Emergency temperature in °C" />
                    <TextBlock Grid.Column="3" Text="°C" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- What the rule watches: helps to choose a limit that real use doesn't reach. -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hottest sensor now" />
                        <TextBlock Text="The rule watches every temperature sensor: CPU, graphics card (hot spot and memory too), motherboard and drives." Style="{StaticResource Sub}" />
                    </StackPanel>
                    <TextBlock x:Name="HottestNow" Grid.Column="1" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Highest since the service started" />
                        <TextBlock Text="Keep the emergency temperature above what games and heavy work reach, or the fans will jump to 100%." Style="{StaticResource Sub}" />
                    </StackPanel>
                    <TextBlock x:Name="HottestMax" Grid.Row="1" Grid.Column="1" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- ===== App ===== -->
            <TextBlock Text="App" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="App theme" />
                        <TextBlock Text="Light or dark, or the same as Windows." Style="{StaticResource Sub}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                              AutomationProperties.Name="App theme" SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Use system setting" Tag="System" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock x:Name="StartupHint" Text="Opens quietly in the tray when you sign in." Style="{StaticResource Sub}" />
                        <controls:LinkButton x:Name="StartupAppsLink" Content="Open Startup apps" Padding="0" Margin="0,2,0,0"
                                         NavigateUri="ms-settings:startupapps" Visibility="Collapsed" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" OnContent="On" OffContent="Off" MinWidth="0"
                                  AutomationProperties.Name="Start with Windows" Toggled="StartupSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Close to the tray" />
                        <TextBlock Text="The close button hides the window to the tray, where the icon shows your pinned readings. Off: the close button exits. Fans and lights stay under control either way – the background service drives them." Style="{StaticResource Sub}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="TraySwitch" Grid.Column="1" OnContent="On" OffContent="Off" MinWidth="0"
                                  AutomationProperties.Name="Close to the tray" Toggled="TraySwitch_Toggled" />
                </Grid>
            </Border>

            <!-- ===== Game overlay ===== -->
            <TextBlock Text="Game overlay" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Show overlay" />
                        <TextBlock x:Name="OverlayHint" Style="{StaticResource Sub}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="OverlaySwitch" Grid.Column="1" OnContent="On" OffContent="Off" MinWidth="0"
                                  AutomationProperties.Name="Show overlay" Toggled="OverlaySwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Position" />
                        <TextBlock x:Name="OverlayMoveHint" Style="{StaticResource Sub}" />
                    </StackPanel>
                    <controls:LinkButton x:Name="OverlayResetLink" Grid.Column="1" Content="Back to the corner" VerticalAlignment="Center"
                                         Click="OverlayReset_Click" />
                    <Button x:Name="OverlayMoveButton" Grid.Column="2" MinWidth="120" VerticalAlignment="Center"
                            Click="OverlayMove_Click" />
                </Grid>
            </Border>

            <!-- ===== Help ===== -->
            <TextBlock Text="Help" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Diagnostics" />
                        <TextBlock Text="Something doesn't work on this PC? Copy a report and paste it into your bug report: what NotOnlyFans found (hardware, sensors, fans, lights), its settings, other fan or RGB software running and recent errors. No user or computer names." Style="{StaticResource Sub}" />
                    </StackPanel>
                    <Button x:Name="DiagnosticsButton" Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                            Content="Copy diagnostics" Click="Diagnostics_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
