<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Background part of NotOnlyFans. Reads sensors and (later) controls fans and RGB.
    Needs administrator rights (motherboard Super I/O chip, CPU registers).
    Live mode streams sensors over a named pipe; the dump option writes docs\sensors-dump.txt.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NotOnlyFans.Service</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotOnlyFans.Contracts\NotOnlyFans.Contracts.csproj" />
  </ItemGroup>

</Project>
